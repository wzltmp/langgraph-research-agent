ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Optional: MCP Automations server used by read_node's summarize_via_mcp().
# Defaults to the deployed Fly server if unset. Override to point at a local
# server for testing (e.g. `MCP_TRANSPORT=http python -m mcp_server.server`
# in the mcp-automations repo, then set this to http://localhost:8765/mcp).
MCP_AUTOMATIONS_URL=https://mcp-automations.fly.dev/mcp

# Optional: enable LangSmith tracing
# Get a free API key at https://smith.langchain.com (Developer tier = 5k traces/mo).
# LangGraph auto-instruments when these three are set — no code change needed.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=research-agent
