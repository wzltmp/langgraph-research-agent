# Copy to .streamlit/secrets.toml locally (gitignored) OR paste into
# Streamlit Cloud → Settings → Secrets for the deployed app.
# python-dotenv reads .env locally; Streamlit Cloud injects these as os.environ.

ANTHROPIC_API_KEY = "sk-ant-..."
TAVILY_API_KEY = "tvly-..."

# Optional — enables LangSmith tracing
# LANGSMITH_API_KEY = "lsv2_..."
# LANGSMITH_TRACING = "true"
# LANGSMITH_PROJECT = "research-agent"
